{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastFind",
  "version": "1.1.1",
  "identifier": "app.fastfind.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FastFind",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwRUNFMDQ4MUJFQzcyOEIKUldTTGN1d2JTT0Rzd0N5SkVmT1pEdmI0eXNVVUNkbjcycnIrQWtTblBTWnU5R2FzQXNBb1hKdjQK",
      "endpoints": ["https://github.com/ZEraX4/FastFind/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "app", "dmg", "appimage", "deb"],
    "publisher": "FastFind",
    "category": "Productivity",
    "shortDescription": "Fast local full-text file search",
    "longDescription": "FastFind indexes your folders locally and finds text inside documents, PDFs, spreadsheets, presentations and code in milliseconds. Nothing leaves your computer.",
    "copyright": "© 2026 FastFind contributors",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "pdfium/*": "pdfium/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
